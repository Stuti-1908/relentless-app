# Relentless AI web app — environment variables
# Copy this file to ".env.local" and fill in real values (never commit .env.local).

# --- Supabase (auth + later DB) ---
# Create a project at https://supabase.com -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# --- Server-only secrets (NEVER prefix with NEXT_PUBLIC_) ---
# Airtable Personal Access Token (read/write the client data) + base id
AIRTABLE_PAT=
AIRTABLE_BASE_ID=appjnWxg9sB3PV7Da

# GoHighLevel Private Integration token (for task mirror / Execution scoring) — optional in v1
GHL_TOKEN=
GHL_LOCATION_ID=HlI90j86nBEuhp9Oovf9

# Beta-tester payment gate bypass — a shared code that skips /payment for
# pre-launch testers. See api/payment/beta-bypass/route.ts. Unset = bypass
# always rejects (fails closed). Rotate/remove by changing this value, no
# code change needed.
RELENTLESS_BETA_BYPASS_CODE=

# --- Stripe ($69/month subscription via a Stripe Payment Link, switched
# from Square 2026-08-29/30). Checkout itself uses a fixed Payment Link
# (see STRIPE_PAYMENT_LINK constant in payment/page.tsx), not a
# dynamically-created Checkout Session — no STRIPE_PRICE_ID needed.
# Restricted key (rk_live_... / rk_test_...) from Stripe Dashboard ->
# Developers -> API keys. Used by api/payment/stripe-webhook to construct/
# verify incoming webhook events.
STRIPE_SECRET_KEY=
# Signing secret for the webhook endpoint (Dashboard -> Developers ->
# Webhooks -> your endpoint -> Signing secret, starts with "whsec_").
# Required for api/payment/stripe-webhook to verify requests really came
# from Stripe — without it, that route rejects everything.
STRIPE_WEBHOOK_SECRET=
