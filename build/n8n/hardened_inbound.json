sCode": "const crypto = require('crypto');\nconst j = $input.first().json;\nconst headers = j.headers || {};\nconst params = j.body || {};\nconst token = $env.TWILIO_AUTH_TOKEN || '';\nconst proto = headers['x-forwarded-proto'] || 'https';\nconst host = headers['x-forwarded-host'] || headers['host'] || '';\n// Production path is hard-coded so the signed URL is deterministic (matches what Twilio signs).\nconst url = proto + '://' + host + '/webhook/twilio-inbound';\nconst signed = Object.keys(params).sort().reduce((a,k)=> a + k + params[k], url);\nconst provided = headers['x-twilio-signature'] || '';\nlet ok = false;\nif (token && provided) {\n  const expected = crypto.createHmac('sha1', token).update(signed, 'utf8').digest('base64');\n  try { ok = crypto.timingSafeEqual(Buffer.from(expected), Buffer.from(provided)); } catch (e) { ok = false; }\n}\nif (!ok) return [];                       // forged / unsigned -> drop silently (no processing)\nconst messageSid = params.MessageSid || params.SmsMessageSid || '';\nreturn [{ json: { messageSid } }];"}}, {"id": "node-searchseen", "name": "searchSeen", "type": "n8n-nodes-base.airtable", "typeVersion": 2.2, "position": [500, 260], "alwaysOutputData": true, "credentials": {"airtableTokenApi": {"id": "Z1DGfO9LPHXmAo4W", "name": "Airtable Goecoach Personal Access Token account"}}, "parameters": {"operation": "search", "base": {"__rl": true, "value": "appjnWxg9sB3PV7Da", "mode": "list", "cachedResultName": "Relentless AI - client_test"}, "table": {"__rl": true, "value": "tbl29Je265sMgO66w", "mode": "list", "cachedResultName": "tbl_inbound_seen"}, "filterByFormula": "={{ \"{message_sid} = '\" + $json.messageSid + \"'\" }}", "options": {}}}, {"id": "node-dedup", "name": "dedupGate", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [660, 260], "parameters": {"jsCode": "const found = $('searchSeen').all().filter(i => i.json && i.json.id);\nif (found.length > 0) return [];          // duplicate MessageSid -> drop (idempo