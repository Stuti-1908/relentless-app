# Relentless AI web app — environment variables
# Copy this file to ".env.local" and fill in real values (never commit .env.local).

# --- Supabase (auth + later DB) ---
# Create a project at https://supabase.com -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# --- Server-only secrets (NEVER prefix with NEXT_PUBLIC_) ---
# Airtable Personal Access Token (read/write the client data) + base id
AIRTABLE_PAT=
AIRTABLE_BASE_ID=appjnWxg9sB3PV7Da

# GoHighLevel Private Integration token (for task mirror / Execution scoring) — optional in v1
GHL_TOKEN=
GHL_LOCATION_ID=HlI90j86nBEuhp9Oovf9
