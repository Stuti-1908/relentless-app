{"updatedAt": "2026-06-05T07:57:02.519Z", "createdAt": "2026-06-02T15:05:37.103Z", "id": "inbHardenedV1", "name": "Relentless AI - Inbound HARDENED (test)", "description": null, "active": false, "isArchived": false, "nodes": [{"parameters": {"httpMethod": "POST", "path": "twilio-inbound", "options": {}}, "type": "n8n-nodes-base.webhook", "typeVersion": 2.1, "position": [224, 64], "id": "e8015a1c-736d-44b9-bfc8-87db07862978", "name": "Webhook", "webhookId": "a1b2c3d4-0000-4000-8000-000000000001"}, {"parameters": {"jsCode": "function clamp(x, lo, hi) { return Math.max(lo, Math.min(hi, x)); }\nfunction roundHalfUp(x) { return Math.round(x); }\nfunction manualRecovery(sleep, energy, stress) {\n  const sleepEq = clamp(sleep, 1, 5) * 14;\n  const energyRec = clamp(energy, 1, 5) * 18;\n  const stressAdj = (6 - clamp(stress, 1, 5)) * 8;\n  return roundHalfUp(Math.min(100, (sleepEq + energyRec + stressAdj) / 2.0));\n}\n\nconst body = $('Webhook').first().json.body || {};\nconst fromRaw = String(body.From || '');\nconst toNumber = fromRaw.replace('whatsapp:', '');\nconst text = String(body.Body || '').trim();\nconst upper = text.toUpperCase();\nconst CID = 'client_test';\n\n// 1) BIOMETRIC: three 1-5 numbers (the tested daily check-in path) — checked FIRST, unchanged.\nconst nums = (text.match(/[1-5]/g) || []).map(Number);\nif (nums.length >= 3) {\n  const sleep = nums[0], energy = nums[1], stress = nums[2];\n  const recovery = manualRecovery(sleep, energy, stress);\n  return [{ json: { type:'biometric', valid:true, toNumber:toNumber, client_id:CID, sleep:sleep, energy:energy, stress:stress, recovery:recovery,\n    reply: 'Got it. Sleep ' + sleep + ', energy ' + energy + ', stress ' + stress + '. Your recovery today is ' + recovery + '/100.' } }];\n}\n\n// 2) FEEDBACK keywords — unchanged. Classify briefing vs score by time of day.\nconst fbType = ($now.hour < 14) ? 'briefing' : 'score';\nif (upper === 'YES' || upper === 'Y') {\n  return [{ json: { type:'feedback', valid:false, toNumber:toNumber, client_id:CID, fb_type:fbType, helpful:true, feedback_text:'', reply:'Thanks for the feedback. Noted.' } }];\n}\nif (upper === 'NO' || upper === 'N') {\n  return [{ json: { type:'feedback', valid:false, toNumber:toNumber, client_id:CID, fb_type:fbType, helpful:false, feedback_text:'', reply:'Thanks. I will use that to sharpen tomorrow.' } }];\n}\nif (upper === 'SOMEWHAT') {\n  return [{ json: { type:'feedback', valid:false, toNumber:toNumber, client_id:CID, fb_type:fbType, helpful:null, feedback_text:'somewhat', reply:'Thanks for the honest read.' } }];\n}\nif (upper === 'SKIP') {\n  return [{ json: { type:'ack', valid:false, toNumber:toNumber, client_id:CID, reply:'No problem, skipped.' } }];\n}\n\n// 3) FREEFORM reply -> treat as a NUDGE REPLY (engagement signal). The IsNudgeReply branch marks the\n//    latest recent unanswered nudge responded=true. (Was a plain 'ack' before; biometric+feedback win first.)\nreturn [{ json: { type:'nudge_reply', valid:false, toNumber:toNumber, client_id:CID,\n  reply:'Got it - logged your reply. Keep the momentum.' } }];\n"}, "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [448, 64], "id": "eb2c097d-ca3f-4427-8ae2-0447b7ed767e", "name": "scoreReply"}, {"parameters": {"from": "+14155238886", "to": "={{ $json.toNumber }}", "toWhatsapp": true, "message": "={{ $json.reply }}", "options": {}}, "type": "n8n-nodes-base.twilio", "typeVersion": 1, "position": [672, -128], "id": "567ac0e8-e102-4bf1-82b1-75de1fa20771", "name": "Send an SMS/MMS/WhatsApp message", "credentials": {"twilioApi": {"id": "Iup3ZRFuOaK60uct", "name": "Twilio account"}}}, {"parameters": {"conditions": {"options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 3}, "conditions": [{"id": "da587322-f85c-49ba-ac44-e4d9923f9736", "leftValue": "={{ $json.valid }}", "rightValue": "", "operator": {"type": "boolean", "operation": "true", "singleValue": true}}], "combinator": "and"}, "options": {}}, "type": "n8n